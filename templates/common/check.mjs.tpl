// Generated by x402-starter-kit. Starts your seller on 127.0.0.1, runs Wasit against it, writes report.md and
// report.json (report-full.md and report-full.json for the full run, so one never overwrites the other), and prints
// a summary. Testnet only. By default only the read-only checks run and no payment is made;
// `npm run check:full` also makes test payments on Stellar testnet.
// Wasit's answer is copied into the report as it is; nothing here decides a result.
//
//   npm run check                 uses the public testnet facilitator when it is reachable, otherwise offline mode
//   npm run check -- --offline    force offline mode (a local stand-in for the facilitator; challenge checks only)
//   npm run check -- --online     force the public testnet facilitator
//   npm run check:full            all 10 checks, including test payments on Stellar testnet. It needs a funded testnet
//                                 payer: run it once and it tells you what is missing. Public facilitator only.
import { spawn } from "node:child_process";
import fs from "node:fs";
import net from "node:net";
import path from "node:path";
import readline from "node:readline/promises";
import { fileURLToPath } from "node:url";
import { buildReport, renderMarkdown, renderTerminal, maskSecrets } from "./report.mjs";
import { FAUCET_URL, checkPayerReady, createPayer, ensureFullPayee, parsePrice, payerCreatedText, payerHelp } from "./full.mjs";
import { FULL_QUESTION, nextStepsText, parseYesNo, shouldAsk } from "./nextsteps.mjs";
import { DEFAULT_FACILITATOR_URL, chooseFacilitatorMode, probeFacilitator, startStubFacilitator } from "./facilitator.mjs";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const project = JSON.parse(fs.readFileSync(path.join(root, "project.json"), "utf8"));
const { method, path: routePath } = project.variant;
const NETWORK = "stellar:testnet";
// Wasit runs through npx in its own folder, NOT inside this project: its dependency tree (it needs an older
// @stellar/stellar-sdk for MPP) would clash with the newer one the x402 libraries use here.
const WASIT_VERSION = "0.7.0";
const IS_WIN = process.platform === "win32";
const FACILITATOR_HINT = "The seller could not reach the public testnet facilitator. Check your internet connection, or run: npm run check -- --offline";
const FACILITATOR_HINT_CUSTOM = "The seller could not reach the facilitator at FACILITATOR_URL. Check that address, or unset FACILITATOR_URL.";
const FACILITATOR_HINT_FULL = "The seller could not reach the public testnet facilitator. Check your internet connection and run again.";

if (Number(process.versions.node.split(".")[0]) < 22) {
  console.error(`Node.js 22 or newer is required. You have ${process.versions.node}. Install Node.js 22 or newer, then run this again.`);
  process.exit(2);
}

const argv = process.argv.slice(2);
for (const a of argv) {
  if (a !== "--offline" && a !== "--online" && a !== "--full") {
    console.error(`Unknown option ${a}. Use --offline, --online or --full.`);
    process.exit(2);
  }
}
const FULL = argv.includes("--full");
if (argv.includes("--offline") && argv.includes("--online")) {
  console.error("Use either --offline or --online, not both.");
  process.exit(2);
}
if (FULL && argv.includes("--offline")) {
  console.error("--full needs the real facilitator: a payment cannot be settled without it. Remove --offline.");
  process.exit(2);
}
if (FULL && process.env.FACILITATOR_URL) {
  console.error("--full uses the public testnet facilitator only. Unset FACILITATOR_URL for this run.");
  process.exit(2);
}

function freePort() {
  return new Promise((resolve, reject) => {
    const s = net.createServer();
    s.once("error", reject);
    s.listen(0, "127.0.0.1", () => {
      const { port } = s.address();
      s.close(() => resolve(port));
    });
  });
}

const running = new Set(); // Wasit processes started by run(), so Ctrl-C can stop them too

function run(cmd, args, { timeoutMs = 180000, shell = false } = {}) {
  return new Promise((resolve) => {
    const child = spawn(cmd, args, { cwd: root, shell, stdio: ["ignore", "pipe", "pipe"] });
    running.add(child);
    let stdout = "";
    let stderr = "";
    const timer = setTimeout(() => child.kill(), timeoutMs);
    child.stdout.on("data", (d) => (stdout += d));
    child.stderr.on("data", (d) => (stderr += d));
    child.on("close", (code) => {
      clearTimeout(timer);
      running.delete(child);
      resolve({ code, stdout, stderr });
    });
    child.on("error", (e) => {
      clearTimeout(timer);
      running.delete(child);
      resolve({ code: -1, stdout, stderr: String(e) });
    });
  });
}

async function waitForServer(url, child, timeoutMs = 30000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    if (child.exitCode !== null) return false;
    try {
      await fetch(url, { signal: AbortSignal.timeout(5000) }); // any HTTP answer means the server is up
      return true;
    } catch {
      await new Promise((r) => setTimeout(r, 300));
    }
  }
  return false;
}

/** How to start Wasit. WASIT_BIN (a path to Wasit's dist/index.js) is for development only. */
async function wasitCommand() {
  let cmd, prefix, shell;
  if (process.env.WASIT_BIN) {
    cmd = process.execPath;
    prefix = [path.resolve(process.env.WASIT_BIN)];
    shell = false;
  } else {
    cmd = IS_WIN ? "npx.cmd" : "npx";
    prefix = ["-y", `@wasit-dev/cli@${WASIT_VERSION}`];
    shell = IS_WIN;
  }
  const v = await run(cmd, [...prefix, "--version"], { shell });
  if (v.code !== 0) {
    throw new Error(`Wasit could not be started (it needs internet the first time): ${v.stderr || v.stdout}`);
  }
  return { cmd, prefix, shell, version: v.stdout.trim() };
}

/**
 * Make a test payer in this project: the secret key goes into .env (never overwritten, never printed) and the PUBLIC
 * address into payer-address.txt. Prints the address (and the faucet steps if the payer holds no USDC yet). Returns the
 * made payer ({ publicKey, swapped, usdcBalance }) or null.
 */
async function setupPayer() {
  const envPath = path.join(root, ".env");
  if (fs.existsSync(envPath)) {
    console.log("A .env file already exists in this folder, so the kit did not make a payer. If it holds your test payer key you are ready; otherwise run npm run check:full for the steps.");
    return null;
  }
  console.log("Creating a test payer on Stellar testnet (test funds only) ...");
  try {
    const stellar = await import("@stellar/stellar-sdk");
    const made = await createPayer({
      stellar: { Keypair: stellar.Keypair, Horizon: stellar.Horizon, TransactionBuilder: stellar.TransactionBuilder, Operation: stellar.Operation, Asset: stellar.Asset, Networks: stellar.Networks, BASE_FEE: stellar.BASE_FEE },
      writeEnv: (secret) => fs.writeFileSync(envPath, `STELLAR_PRIVATE_KEY=${secret}\n`, { flag: "wx", mode: 0o600 }),
    });
    fs.writeFileSync(path.join(root, "payer-address.txt"), `${made.publicKey}\n`);
    console.log(payerCreatedText(made.publicKey, made));
    if (!made.swapped && process.stdout.isTTY && !process.env.CI) openAddress(FAUCET_URL);
    return made;
  } catch (e) {
    console.error(maskSecrets(String(e?.message || e)));
    return null;
  }
}

/** Best effort: open an address in the default browser. If nothing happens, the address is already printed. */
function openAddress(url) {
  try {
    const [cmd, args] =
      process.platform === "darwin" ? ["open", [url]] : process.platform === "win32" ? ["rundll32", ["url.dll,FileProtocolHandler", url]] : ["xdg-open", [url]];
    const child = spawn(cmd, args, { stdio: "ignore", detached: true });
    child.on("error", () => {});
    child.unref();
  } catch {
    // nothing else to do
  }
}

/** Full run only: is the payer ready, and is there a payee? Returns { payee } or { stop: exitCode }. */
async function prepareFull(wasit) {
  const price = parsePrice(project.variant.price);
  const shown = `npx -y @wasit-dev/cli@${WASIT_VERSION}`;
  const st = await run(wasit.cmd, [...wasit.prefix, "wallet", "status", "--role", "x402", "--network", NETWORK, "--json"], { shell: wasit.shell });
  let parsed = null;
  try {
    parsed = JSON.parse(st.stdout);
  } catch {
    console.error(`Could not read the payer status: ${maskSecrets(st.stderr || st.stdout)}\nCheck your internet connection and run again.`);
    return { stop: 2 };
  }
  const ready = checkPayerReady(parsed, price);
  const envPath = path.join(root, ".env");
  if (!ready.ok && ready.reason === "not-configured" && !fs.existsSync(envPath)) {
    // No payer yet and no .env to protect: make one. The secret goes into .env and is never printed.
    console.log("No test payer yet.");
    const made = await setupPayer();
    if (made?.swapped) return prepareFull(wasit); // it already holds test USDC: carry on with the full run
    if (!made) console.log(maskSecrets(payerHelp(ready, { price: project.variant.price, wasitCommand: shown })));
    return { stop: 2 };
  }
  if (!ready.ok) {
    console.log(maskSecrets(payerHelp(ready, { price: project.variant.price, wasitCommand: shown })));
    return { stop: 2 };
  }
  console.log(`Payer ${ready.publicKey} holds ${ready.balance} USDC (testnet).`);
  const stellar = await import("@stellar/stellar-sdk");
  const { Keypair, Horizon, TransactionBuilder, Operation, Asset, Networks, BASE_FEE } = stellar;
  try {
    const r = await ensureFullPayee({
      project,
      stellar: { Keypair, Horizon, TransactionBuilder, Operation, Asset, Networks, BASE_FEE },
      save: (p) => fs.writeFileSync(path.join(root, "project.json"), JSON.stringify(p, null, 2) + "\n"),
    });
    console.log(r.created ? `Created a throwaway payee ${r.payee} (nobody holds its secret key).` : `Payee ${r.payee}.`);
    return { payee: r.payee, payer: ready.publicKey };
  } catch (e) {
    console.error(maskSecrets(String(e?.message || e)));
    return { stop: 2 };
  }
}

async function main() {
  // 1. Which facilitator? Never probe when the participant already decided.
  const envUrl = process.env.FACILITATOR_URL || "";
  const decided = Boolean(envUrl) || argv.includes("--offline") || argv.includes("--online") || FULL;
  const probeUrl = process.env.KIT_PROBE_URL || `${DEFAULT_FACILITATOR_URL}/supported`;
  const reachable = decided ? null : await probeFacilitator(probeUrl);
  const choice = chooseFacilitatorMode({ envUrl, offline: argv.includes("--offline"), online: argv.includes("--online") || FULL, reachable });

  let stub = null;
  let facilitatorUrl = choice.url;
  if (choice.mode === "stub") {
    stub = await startStubFacilitator();
    facilitatorUrl = stub.url;
    console.log(
      argv.includes("--offline")
        ? "Offline mode (--offline): using a local stand-in for the facilitator. Challenge checks only."
        : "The public facilitator is not reachable: using offline mode, a local stand-in for it. Challenge checks only.",
    );
  }

  // 1a. An exercise project holds a planted defect. Real payments only go to it once the last report says solved.
  if (FULL && project.exercise) {
    let last = null;
    try {
      last = JSON.parse(fs.readFileSync(path.join(root, "report.json"), "utf8"));
    } catch {}
    let stale = true;
    try {
      stale = fs.statSync(path.join(root, "report.json")).mtimeMs < fs.statSync(path.join(root, "server.mjs")).mtimeMs;
    } catch {}
    if (last?.exercise?.status !== "solved" || stale) {
      console.error("This is an exercise project. Fix it first: run npm run check until the exercise says solved (and do not change server.mjs after that), then try the full run.");
      await stub?.close();
      process.exitCode = 2;
      return;
    }
  }

  // 1b. Full run: payer and payee must be ready before anything starts.
  let fullPayee = null;
  let fullPayer = null;
  let wasit = { version: "unknown" };
  if (FULL) {
    try {
      wasit = await wasitCommand();
    } catch (e) {
      console.error(maskSecrets(String(e?.message || e)));
      await stub?.close();
      process.exitCode = 2;
      return;
    }
    const prep = await prepareFull(wasit);
    if (prep.stop !== undefined) {
      await stub?.close();
      process.exitCode = prep.stop;
      return;
    }
    fullPayee = prep.payee;
    fullPayer = prep.payer;
  }

  // 2. Start the seller.
  const port = await freePort();
  const target = `http://127.0.0.1:${port}${routePath}`;
  const server = spawn(process.execPath, ["server.mjs"], {
    cwd: root,
    // The seller never gets a key: anything that looks like one is dropped from its environment.
    env: {
      ...Object.fromEntries(
        Object.entries(process.env).filter(
          ([k, v]) => !/PRIVATE_KEY|SECRET|TOKEN|API_?KEY|MNEMONIC|SEED|PASSWORD|PASSPHRASE/i.test(k) && maskSecrets(v ?? "") === String(v ?? ""),
        ),
      ),
      PORT: String(port),
      FACILITATOR_URL: facilitatorUrl,
      ...(fullPayee ? { PAY_TO: fullPayee } : {}),
    },
    stdio: ["ignore", "pipe", "pipe"],
  });
  let serverLog = "";
  const keep = (d) => (serverLog = (serverLog + d).slice(-4000));
  server.stdout.on("data", keep);
  server.stderr.on("data", keep);
  const stop = async () => {
    if (server.exitCode === null) server.kill();
    for (const c of running) c.kill();
    await stub?.close();
  };
  process.on("SIGINT", async () => {
    await stop();
    process.exit(130);
  });

  // 3. Run Wasit.
  let wasitJson = null;
  let harnessError = null;
  const methodArgs = method === "POST" ? ["--method", "POST"] : [];
  try {
    if (!FULL) wasit = await wasitCommand();
    if (!(await waitForServer(target, server))) {
      harnessError = "The seller did not start. If you have not run `npm install` in this folder yet, run it and try again. Seller output: " + (serverLog || "no output");
    } else {
      if (FULL) console.log(`Full run: Wasit will now pay this seller ${project.variant.price} in test USDC once (X402-06) and send four payments it must refuse (X402-07 to 10). Testnet funds only.`);
      const args = [...wasit.prefix, "test", "--target", target, "--network", NETWORK, ...(FULL ? [] : ["--read-only"]), "--json", ...methodArgs];
      const out = await run(wasit.cmd, args, { shell: wasit.shell, timeoutMs: FULL ? 600000 : 180000 });
      try {
        wasitJson = JSON.parse(out.stdout);
      } catch {
        harnessError = `Wasit exit code ${out.code}. Check your internet connection and run again. ${out.stderr || out.stdout}`;
      }
    }
  } catch (e) {
    harnessError = String(e?.message || e);
  } finally {
    await stop();
  }

  // 4. Report.
  const report = buildReport({
    project,
    wasit: {
      version: wasit.version,
      command: `wasit test --target ${target} --network ${NETWORK}${FULL ? "" : " --read-only"} --json${methodArgs.length ? " --method POST" : ""}`,
    },
    // "real" only for the public testnet facilitator, "stub" for the local stand-in, "custom" for anything else,
    // so a report never claims more than was used.
    facilitator: { mode: choice.mode, url: facilitatorUrl },
    kitVersion: project.kitVersion,
    generatedAt: new Date().toISOString(),
    wasitJson,
    harnessError,
    exercise: project.exercise ?? null,
    full: FULL,
    payer: fullPayer,
  });
  const reportName = FULL ? "report-full" : "report";
  fs.writeFileSync(path.join(root, `${reportName}.json`), JSON.stringify(report, null, 2) + "\n");
  fs.writeFileSync(path.join(root, `${reportName}.md`), renderMarkdown(report));

  console.log(renderTerminal(report));
  console.log(`Report    ./${reportName}.md  ./${reportName}.json`);
  if (/Failed to fetch supported kinds/i.test(serverLog)) console.log("\n" + (envUrl ? FACILITATOR_HINT_CUSTOM : FULL ? FACILITATOR_HINT_FULL : FACILITATOR_HINT));
  process.exitCode = report.outcome === "conformant" ? 0 : report.outcome === "non-conformant" ? 1 : 2;

  // What to do next. The question only appears in a real terminal after a conformant read-only run.
  const exerciseUnsolved = Boolean(project.exercise) && report.exercise?.status !== "solved";
  const ctx = { full: FULL, outcome: report.outcome, exerciseUnsolved };
  let answeredYes;
  if (shouldAsk({ ...ctx, interactive: process.stdin.isTTY && process.stdout.isTTY && !process.env.CI })) {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    try {
      for (let i = 0; i < 3 && answeredYes === undefined; i++) {
        const parsed = parseYesNo(await rl.question("\n" + FULL_QUESTION));
        if (parsed !== null) answeredYes = parsed;
      }
    } catch {
      // the terminal closed: treat it as no
    } finally {
      rl.close();
    }
    if (answeredYes === undefined) answeredYes = false;
  }
  // Yes: make the payer now, so the participant only has to get test USDC and run the full check.
  let payerReady = false;
  if (answeredYes === true) {
    console.log("");
    payerReady = Boolean((await setupPayer())?.swapped);
  }
  const text = nextStepsText({ ...ctx, answeredYes, payerReady });
  if (text) console.log("\n" + text);
}

main().catch((e) => {
  console.error(maskSecrets(e?.message || e));
  process.exitCode = 2;
});
