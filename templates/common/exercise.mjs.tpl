// Generated by x402-starter-kit. Something in server.mjs is broken on purpose. Run `npm run check`, read the report,
// find it and fix it. When all checks pass, the exercise is solved.
//
//   npm run exercise -- --hint     a nudge, without the answer
//   npm run exercise -- --reveal   the answer: what the defect was and how to fix it
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const file = path.join(root, ".exercise.json");
const arg = process.argv[2];

if (!fs.existsSync(file)) {
  console.log("This project has no exercise.");
  process.exit(0);
}
const answer = JSON.parse(fs.readFileSync(file, "utf8"));

if (arg === "--hint") {
  console.log(`Hint: ${answer.hint}`);
} else if (arg === "--reveal") {
  console.log(`The defect: ${answer.title}\n\n${answer.explanation}`);
} else {
  console.log("Run `npm run check` and read the report to find the defect in server.mjs.\n");
  console.log("  npm run exercise -- --hint     a nudge, without the answer");
  console.log("  npm run exercise -- --reveal   the answer");
}
