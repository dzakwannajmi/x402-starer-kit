// Generated by x402-starter-kit. A small x402 seller for local practice. Testnet only. Not a real service.
// It listens on 127.0.0.1 only, so nothing outside your computer can reach it.
import fs from "node:fs";
import express from "express";
import { Keypair, StrKey } from "@stellar/stellar-sdk";
import { paymentMiddlewareFromConfig } from "@x402/express";
import { HTTPFacilitatorClient } from "@x402/core/server";
import { ExactStellarScheme } from "@x402/stellar/exact/server";

const projectFile = new URL("./project.json", import.meta.url);
const project = JSON.parse(fs.readFileSync(projectFile, "utf8"));

const PORT = Number(process.env.PORT || 4402);
const FACILITATOR_URL = process.env.FACILITATOR_URL || "https://www.x402.org/facilitator";
const NETWORK = "stellar:testnet";

// The payee is a public address only. It is created once and the secret key is discarded on purpose:
// nothing in this project can spend from it. (Paying for real needs a payee you control; see the kit's next phases.)
let payTo = process.env.PAY_TO || project.payee;
if (payTo && !StrKey.isValidEd25519PublicKey(payTo)) {
  throw new Error("PAY_TO is not a valid Stellar public address (G...).");
}
if (!payTo) {
  payTo = Keypair.random().publicKey();
  project.payee = payTo;
  fs.writeFileSync(projectFile, JSON.stringify(project, null, 2) + "\n");
}

const RESOURCE = __RESOURCE_JSON__;

const app = express();
app.use(
  paymentMiddlewareFromConfig(
    { "GET /paid": { accepts: { scheme: "exact", price: project.variant.price, network: NETWORK, payTo } } },
    new HTTPFacilitatorClient({ url: FACILITATOR_URL }),
    [{ network: NETWORK, server: new ExactStellarScheme() }],
  ),
);
app.get("/paid", (_req, res) => res.json(RESOURCE));

app.listen(PORT, "127.0.0.1", () => {
  console.log(`seller ready on http://127.0.0.1:${PORT}/paid (price ${project.variant.price}, ${NETWORK})`);
});
