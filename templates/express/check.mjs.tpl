// Generated by x402-starter-kit. Starts your seller on 127.0.0.1, runs Wasit's read-only checks against it,
// writes report.md and report.json, and prints a summary. Testnet only. No payment is made.
// Wasit's answer is copied into the report as it is; nothing here decides a result.
import { spawn } from "node:child_process";
import fs from "node:fs";
import net from "node:net";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { buildReport, renderMarkdown, renderTerminal, maskSecrets } from "./report.mjs";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const project = JSON.parse(fs.readFileSync(path.join(root, "project.json"), "utf8"));
const DEFAULT_FACILITATOR_URL = "https://www.x402.org/facilitator";
const FACILITATOR_URL = process.env.FACILITATOR_URL || DEFAULT_FACILITATOR_URL;
const NETWORK = "stellar:testnet";
// Wasit runs through npx in its own folder, NOT inside this project: its dependency tree (it needs an older
// @stellar/stellar-sdk for MPP) would clash with the newer one the x402 libraries use here.
const WASIT_VERSION = "0.7.0";
const IS_WIN = process.platform === "win32";
const FACILITATOR_HINT = "The seller could not reach the facilitator. Check your internet connection and run again.";

function freePort() {
  return new Promise((resolve, reject) => {
    const s = net.createServer();
    s.once("error", reject);
    s.listen(0, "127.0.0.1", () => {
      const { port } = s.address();
      s.close(() => resolve(port));
    });
  });
}

function run(cmd, args, { timeoutMs = 180000, shell = false } = {}) {
  return new Promise((resolve) => {
    const child = spawn(cmd, args, { cwd: root, shell, stdio: ["ignore", "pipe", "pipe"] });
    let stdout = "";
    let stderr = "";
    const timer = setTimeout(() => child.kill(), timeoutMs);
    child.stdout.on("data", (d) => (stdout += d));
    child.stderr.on("data", (d) => (stderr += d));
    child.on("close", (code) => {
      clearTimeout(timer);
      resolve({ code, stdout, stderr });
    });
    child.on("error", (e) => {
      clearTimeout(timer);
      resolve({ code: -1, stdout, stderr: String(e) });
    });
  });
}

async function waitForServer(url, child, timeoutMs = 30000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    if (child.exitCode !== null) return false;
    try {
      await fetch(url, { signal: AbortSignal.timeout(5000) }); // any HTTP answer means the server is up
      return true;
    } catch {
      await new Promise((r) => setTimeout(r, 300));
    }
  }
  return false;
}

/** How to start Wasit. WASIT_BIN (a path to Wasit's dist/index.js) is for development only. */
async function wasitCommand() {
  let cmd, prefix, shell;
  if (process.env.WASIT_BIN) {
    cmd = process.execPath;
    prefix = [path.resolve(process.env.WASIT_BIN)];
    shell = false;
  } else {
    cmd = IS_WIN ? "npx.cmd" : "npx";
    prefix = ["-y", `@wasit-dev/cli@${WASIT_VERSION}`];
    shell = IS_WIN;
  }
  const v = await run(cmd, [...prefix, "--version"], { shell });
  if (v.code !== 0) {
    throw new Error(`Wasit could not be started (needs internet the first time): ${v.stderr || v.stdout}`);
  }
  return { cmd, prefix, shell, version: v.stdout.trim() };
}

async function main() {
  const port = await freePort();
  const target = `http://127.0.0.1:${port}/paid`;
  const server = spawn(process.execPath, ["server.mjs"], {
    cwd: root,
    env: { ...process.env, PORT: String(port), FACILITATOR_URL },
    stdio: ["ignore", "pipe", "pipe"],
  });
  let serverLog = "";
  const keep = (d) => (serverLog = (serverLog + d).slice(-4000));
  server.stdout.on("data", keep);
  server.stderr.on("data", keep);
  const stop = () => {
    if (server.exitCode === null) server.kill();
  };
  process.on("SIGINT", () => {
    stop();
    process.exit(130);
  });

  let wasitJson = null;
  let harnessError = null;
  let wasit = { version: "unknown" };
  try {
    wasit = await wasitCommand();
    if (!(await waitForServer(target, server))) {
      harnessError = "The seller did not start: " + (serverLog || "no output");
    } else {
      const args = [...wasit.prefix, "test", "--target", target, "--network", NETWORK, "--read-only", "--json"];
      const out = await run(wasit.cmd, args, { shell: wasit.shell });
      try {
        wasitJson = JSON.parse(out.stdout);
      } catch {
        harnessError = `Wasit exit code ${out.code}. ${out.stderr || out.stdout}`;
      }
    }
  } catch (e) {
    harnessError = String(e?.message || e);
  } finally {
    stop();
  }

  const report = buildReport({
    project,
    wasit: { version: wasit.version, command: `wasit test --target ${target} --network ${NETWORK} --read-only --json` },
    // "real" only for the public testnet facilitator; any other URL is reported as "custom" so a report never
    // claims more than was used.
    facilitator: { mode: FACILITATOR_URL === DEFAULT_FACILITATOR_URL ? "real" : "custom", url: FACILITATOR_URL },
    kitVersion: project.kitVersion,
    generatedAt: new Date().toISOString(),
    wasitJson,
    harnessError,
  });
  fs.writeFileSync(path.join(root, "report.json"), JSON.stringify(report, null, 2) + "\n");
  fs.writeFileSync(path.join(root, "report.md"), renderMarkdown(report));

  console.log(renderTerminal(report));
  console.log("Report    ./report.md  ./report.json");
  if (/Failed to fetch supported kinds/i.test(serverLog)) console.log("\n" + FACILITATOR_HINT);
  process.exitCode = report.outcome === "conformant" ? 0 : report.outcome === "non-conformant" ? 1 : 2;
}

main().catch((e) => {
  console.error(maskSecrets(e?.stack || e));
  process.exitCode = 2;
});
